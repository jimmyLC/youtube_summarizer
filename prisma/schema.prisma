generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
}

// ---------- better-auth (Google sign-in only) ----------

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  /// free | pro. The owner (UNLIMITED_EMAILS) is unlimited whatever this says. Pro is switched on by hand until payments exist.
  plan          String   @default("free")
  /// Videos converted successfully, ever. Deleting a video does not give the quota back.
  conversions   Int      @default(0)
  /// Audio seconds converted in `usageMonth` ("YYYY-MM", Taipei time); pro's monthly allowance is measured on this
  usageMonth    String   @default("")
  usageSeconds  Int      @default(0)

  sessions  Session[]
  accounts  Account[]
  videos    Video[]
  tags      Tag[]
  notebooks Notebook[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

// ---------- App ----------

/// One converted YouTube video per user.
model Video {
  id          String   @id @default(cuid())
  userId      String
  /// For uploads this is an internal id ("up_" + video id), never a real YouTube id
  youtubeId   String
  /// youtube | upload
  origin      String   @default("youtube")
  title       String
  /// True once the user typed a title; the AI title never replaces it
  titleEdited Boolean  @default(false)
  /// Uploads only: the original file's name and size, to spot the same file twice
  fileName    String?
  fileSize    Int?
  /// The YouTube channel (or the upload's notebook name) when it was converted. Grouping uses notebookId.
  channel     String   @default("")
  /// null = 未分類 (uncategorized)
  notebookId  String?
  /// queued | transcribing | summarizing | done | error
  status      String   @default("queued")
  /// Error code shown to the user (see lib/jobs.ts), plus detail for the log
  error       String?
  /// Output language of the summary: zh-TW | en
  lang        String   @default("zh-TW")
  /// JSON: { tldr: string, points: { time: number, title: string, detail: string }[] }
  summary     String?
  /// JSON: [seconds, text][]
  transcript  String?
  /// captions | groq | openai
  source      String?
  /// Length of the recording, set when it counted against the user's quota
  seconds     Int?
  /// True once this video has been counted against the quota (so retries and re-summaries do not count twice)
  counted     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  notebook Notebook?  @relation(fields: [notebookId], references: [id], onDelete: SetNull)
  tags     VideoTag[]

  @@unique([userId, youtubeId])
  @@index([userId, createdAt])
}

/// A folder the user manages. New YouTube videos land in the notebook whose matchChannel is their channel.
model Notebook {
  id           String   @id @default(cuid())
  userId       String
  name         String
  /// YouTube channel name that feeds this notebook; survives renaming. "" = none
  matchChannel String   @default("")
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos Video[]

  @@unique([userId, name])
}

model Tag {
  id     String @id @default(cuid())
  userId String
  name   String

  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  videos VideoTag[]

  @@unique([userId, name])
}

model VideoTag {
  videoId String
  tagId   String

  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
}
