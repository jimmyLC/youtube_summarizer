# SQLite database file
DATABASE_URL="file:./data/app.db"

# better-auth: random secret (openssl rand -base64 32) and the public site URL
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type Web)
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Who may sign in (comma-separated Google emails). Empty = anyone.
ALLOWED_EMAILS=""

# Speech-to-text for videos without captions, and the summary model
GROQ_API_KEY=""
# Backup speech-to-text when Groq fails (optional)
OPENAI_API_KEY=""
DEEPSEEK_API_KEY=""
# DEEPSEEK_MODEL="deepseek-chat"

# Route YouTube requests through a relay on the home network (needed on a VPS, which YouTube blocks)
# YOUTUBE_PROXY="http://<relay-tailscale-ip>:8888"

# Simultaneous audio downloads/transcriptions
# MAX_CONCURRENT_TRANSCRIPTIONS=2
